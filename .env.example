# ─────────────────────────────────────────────────────────────
#  IBM watsonx AI Credentials
# ─────────────────────────────────────────────────────────────
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ─────────────────────────────────────────────────────────────
#  IBM Granite Model IDs
# ─────────────────────────────────────────────────────────────
GRANITE_LLM_MODEL=ibm/granite-3-8b-instruct
GRANITE_VISION_MODEL=ibm/granite-vision-3-2-2b
GRANITE_GUARDIAN_MODEL=ibm/granite-guardian-3-8b
GRANITE_EMBEDDING_MODEL=ibm/granite-embedding-278m-multilingual

# ─────────────────────────────────────────────────────────────
#  Vector Store (ChromaDB)
# ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_FOODS=usda_foods
CHROMA_COLLECTION_GUIDELINES=disease_guidelines

# ─────────────────────────────────────────────────────────────
#  Speech-to-Text (Whisper fallback)
# ─────────────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=base

# ─────────────────────────────────────────────────────────────
#  IBM Watson Speech-to-Text (optional cloud STT)
# ─────────────────────────────────────────────────────────────
WATSON_STT_APIKEY=your_watson_stt_apikey_here
WATSON_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# ─────────────────────────────────────────────────────────────
#  Application Settings
# ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
